{{!
    @template local_bbcotodobien/rule_row

    One rule in the current course report.

    Example context (json):
    {
        "id": 4,
        "name": "Grade items",
        "weighting": "Mandatory",
        "compliance": "0.00",
        "statuslabel": "Fail",
        "statusicon": "",
        "hasguidance": true,
        "guidance": "<p>Fix the gradebook.</p>",
        "hasdetails": true,
        "canexecute": true,
        "auditid": 9,
        "istested": true
    }
}}
{{#istested}}
    <table>
{{/istested}}
<tr>
    <td>
        {{name}}
        {{#hasguidance}}
            <div class="mt-2">
                <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#local-bbcotodobien-guidance-{{id}}" aria-expanded="false"
                        aria-controls="local-bbcotodobien-guidance-{{id}}">
                    {{#str}} guidance, local_bbcotodobien {{/str}}
                </button>
                <div class="collapse local-bbcotodobien-guidance mt-2" id="local-bbcotodobien-guidance-{{id}}">
                    {{{guidance}}}
                </div>
            </div>
        {{/hasguidance}}
    </td>
    <td>{{weighting}}</td>
    <td>{{compliance}}%</td>
    <td>{{{statusicon}}} {{statuslabel}}</td>
    <td>
        <div class="d-flex flex-wrap gap-1">
            <button type="button" class="btn btn-secondary btn-sm" data-action="viewdetail"
                    data-ruleconfigid="{{id}}" data-auditid="{{auditid}}"
                    {{^hasdetails}}disabled{{/hasdetails}}>
                {{#str}} viewdetail, local_bbcotodobien {{/str}}
            </button>
            {{#canexecute}}
                <button type="button" class="btn btn-primary btn-sm" data-action="reevaluate"
                        data-ruleconfigid="{{id}}">
                    {{#str}} reevaluate, local_bbcotodobien {{/str}}
                </button>
            {{/canexecute}}
        </div>
    </td>
</tr>
{{#istested}}
    </table>
{{/istested}}
