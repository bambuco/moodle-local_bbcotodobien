{{!
    @template local_bbcotodobien/current

    Current course audit report.

    Example context (json):
    {
        "courseid": 2,
        "hastypes": true,
        "multipletypes": false,
        "canexecute": true,
        "snapshot": false,
        "rerunurl": "/local/bbcotodobien/view.php",
        "dashboardurl": "/local/bbcotodobien/dashboard.php",
        "types": []
    }
}}
<div class="local-bbcotodobien-current" data-courseid="{{courseid}}" data-contextid="{{contextid}}">
    <div class="mb-3 d-flex flex-wrap gap-2">
        {{#canexecute}}
            <form method="post" action="{{rerunurl}}">
                <button type="submit" class="btn btn-primary">{{#str}} reevaluateall, local_bbcotodobien {{/str}}</button>
            </form>
        {{/canexecute}}
        <a href="{{dashboardurl}}" class="btn btn-secondary">{{#str}} dashboard, local_bbcotodobien {{/str}}</a>
    </div>
    {{^hastypes}}
        <div class="alert alert-info">{{#str}} noapplicabletypes, local_bbcotodobien {{/str}}</div>
    {{/hastypes}}
    {{#hastypes}}
        {{#multipletypes}}
            <div class="accordion" id="local-bbcotodobien-types">
                {{#types}}
                    {{> local_bbcotodobien/type_panel}}
                {{/types}}
            </div>
        {{/multipletypes}}
        {{^multipletypes}}
            {{#types}}
                {{> local_bbcotodobien/type_panel}}
            {{/types}}
        {{/multipletypes}}
    {{/hastypes}}
</div>
