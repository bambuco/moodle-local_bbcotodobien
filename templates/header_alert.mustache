{{!
    @template local_bbcotodobien/header_alert

    Course header alert when compliance is below 100%.

    Example context (json):
    {
        "percent": "0.00",
        "courseurl": "/local/bbcotodobien/view.php?id=2",
        "coursename": "Course 1",
        "level": "warning"
    }
}}
<div class="local-bbcotodobien-headeralert alert alert-{{level}}" role="alert">
    <span>{{#str}} headeralertmessage, local_bbcotodobien, {{percent}} {{/str}}</span>
    <a class="alert-link ms-2" href="{{courseurl}}">{{#str}} currentreport, local_bbcotodobien {{/str}}</a>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
