{{!
    @template local_bbcotodobien/rule_detail

    Diagnostic details for one rule.

    Example context (json):
    {
        "rulename": "Grade items",
        "hasdetails": true,
        "details": [
            {
                "collapseid": "local-bbcotodobien-detail-1",
                "evaluatedat": "Monday, 14 September 2026, 6:00 PM",
                "status": "fail",
                "statusclass": "local-bbcotodobien-status-fail",
                "statuslabel": "Fail",
                "details": "The section summary does not contain the label \"Start:\".",
                "expanded": true,
                "hasfailinggroups": true,
                "failinggroups": [
                    {
                        "intro": "The following sections do not contain the label \"Start:\".",
                        "items": [
                            {"name": "Topic 1", "url": "https://example.com/course/section.php?id=2", "hasurl": true},
                            {"name": "Topic 2", "url": "", "hasurl": false}
                        ]
                    }
                ]
            }
        ]
    }
}}
<div class="local-bbcotodobien-ruledetail">
    <h4 class="h5">{{rulename}}</h4>
    {{^hasdetails}}
        <p>{{#str}} nodetails, local_bbcotodobien {{/str}}</p>
    {{/hasdetails}}
    {{#hasdetails}}
        <div class="accordion" id="local-bbcotodobien-details">
            {{#details}}
                <div class="accordion-item {{statusclass}}">
                    <h5 class="accordion-header">
                        <button class="accordion-button{{^expanded}} collapsed{{/expanded}}" type="button"
                                data-bs-toggle="collapse" data-bs-target="#{{collapseid}}"
                                aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}">
                            {{statuslabel}}{{#evaluatedat}} - {{evaluatedat}}{{/evaluatedat}}
                        </button>
                    </h5>
                    <div id="{{collapseid}}"
                         class="accordion-collapse collapse{{#expanded}} show{{/expanded}}"
                         data-bs-parent="#local-bbcotodobien-details">
                        <div class="accordion-body">
                            {{{details}}}
                            {{#hasfailinggroups}}
                                {{#failinggroups}}
                                    <div class="local-bbcotodobien-failinggroup mt-3">
                                        <p>{{intro}}</p>
                                        <ul>
                                            {{#items}}
                                                <li>
                                                    {{#hasurl}}
                                                        <a href="{{url}}">{{name}}</a>
                                                    {{/hasurl}}
                                                    {{^hasurl}}
                                                        {{name}}
                                                    {{/hasurl}}
                                                </li>
                                            {{/items}}
                                        </ul>
                                    </div>
                                {{/failinggroups}}
                            {{/hasfailinggroups}}
                        </div>
                    </div>
                </div>
            {{/details}}
        </div>
    {{/hasdetails}}
</div>
